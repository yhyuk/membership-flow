# Copy to .env (gitignored) and fill values for local development.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/membership_flow?useSSL=false&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=

# --- LLM ---
# 비어 있어도 부팅은 정상 동작 — 이력 조회 API는 status=DEGRADED + summary=null로 응답 (HTTP 200).
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- External API ---
CSRNG_BASE_URL=https://csrng.net

# --- App ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
