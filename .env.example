# Copy to .env (gitignored) and fill values for local development.

# --- Database ---
# 모드 A (호스트 앱) 기본값. 모드 B (docker compose --profile app)에서는 compose가 자동으로 host=mysql로 주입.
DB_URL=jdbc:mysql://localhost:3306/subscription?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=subscription
DB_PASSWORD=subscription

# MySQL 컨테이너 설정 (docker-compose가 사용)
MYSQL_DATABASE=subscription
MYSQL_USER=subscription
MYSQL_PASSWORD=subscription
MYSQL_ROOT_PASSWORD=root
# 호스트 측 3306이 다른 MySQL/MariaDB로 점유된 경우 3307 등으로 변경
MYSQL_HOST_PORT=3306

# --- LLM ---
# 비어 있어도 부팅은 정상 동작 — 이력 조회 API는 status=DEGRADED + summary=null로 응답 (HTTP 200).
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- External API ---
# 전체 엔드포인트 경로까지 포함 — application.yml 기본값과 일치시킨다.
CSRNG_BASE_URL=https://csrng.net/csrng/csrng.php

# --- App ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
